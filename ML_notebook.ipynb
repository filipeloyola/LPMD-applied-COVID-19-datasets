    "hosp = ['1', '2', '3', '4']\n",
    "\n",
    "for n in hosp:\n",
    "        \n",
    "    # Configurações de estilo\n",
    "    sns.set_theme(style=\"whitegrid\")\n",
    "    plt.rcParams['font.size'] = 12\n",
    "\n",
    "    # Carregar arquivo\n",
    "    file_path = 'hosp'+ n +'_resultados.xlsx'\n",
    "    sheet_names = ['(a) Gradient Boosting', '(b) Random Forest', '(c) Support Vector Machine']\n",
    "\n",
    "    # Paleta de cores\n",
    "    cores = sns.color_palette(\"deep\", n_colors=7)\n",
    "\n",
    "    # Criar figura com subplots verticais (SEM sharex)\n",
    "    fig, axes = plt.subplots(3, 1, figsize=(12, 15), sharex=False)  # sharex=False para rótulos independentes\n",
    "    fig.suptitle('Classification analysis of models created from Dataset '+ n, fontsize=16, y=1.02)\n",
    "\n",
    "    # Loop para cada aba\n",
    "    for ax, sheet_name in zip(axes, sheet_names):\n",
    "        df = pd.read_excel(file_path, sheet_name=sheet_name, header=[0], index_col=0)\n",
    "        \n",
    "        metrics = df.index.tolist()\n",
    "        algorithms = [col.split('_')[0] for col in df.columns if '_mean' in col]\n",
    "        \n",
    "        bar_width = 0.12\n",
    "        spacing = 0.02\n",
    "        x_pos = np.arange(len(metrics))\n",
    "        \n",
    "        for i, algo in enumerate(algorithms):\n",
    "            means = df[f'{algo}_mean'].values\n",
    "            stds = df[f'{algo}_std'].values\n",
    "            ax.bar(\n",
    "                x_pos + i * (bar_width + spacing),\n",
    "                means,\n",
    "                bar_width,\n",
    "                yerr=stds,\n",
    "                label=algo,\n",
    "                color=cores[i],\n",
    "                capsize=5,\n",
    "                edgecolor='black',\n",
    "                alpha=0.9\n",
    "            )\n",
    "        \n",
    "        # Configurações do subplot (rótulos em TODOS os gráficos)\n",
    "        ax.set_xticks(x_pos + (len(algorithms) / 2) * (bar_width + spacing) - bar_width / 2)\n",
    "        ax.set_xticklabels(['AUC', 'Recall (Positive)', 'Specificity (Negative)'])  # Rotação opcional\n",
    "        ax.set_ylabel('Score', fontsize=12)\n",
    "        ax.set_title(f'{sheet_name} model', fontsize=14, pad=12)\n",
    "        ax.grid(axis='y', linestyle='--', alpha=0.3)\n",
    "        \n",
    "        # Legenda apenas no primeiro gráfico\n",
    "        if ax == axes[0]:\n",
    "            ax.legend(bbox_to_anchor=(1.15, 1), loc='upper right')\n",
    "\n",
    "    # Ajustes finais\n",
    "    sns.despine(left=True, bottom=True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
