    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "\n",
    "# Configurar estilo visual\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams['font.size'] = 12\n",
    "\n",
    "# Carregar o arquivo Excel\n",
    "file_path = 'hosp1_resultados.xlsx'\n",
    "sheet_names = ['SVM', 'GB', 'RF']  # Nomes das abas\n",
    "\n",
    "# Paleta de cores do Seaborn\n",
    "cores = sns.color_palette(\"deep\", n_colors=7)  # 7 algoritmos\n",
    "\n",
    "# Loop para cada aba\n",
    "for sheet_name in sheet_names:\n",
    "    # Ler dados da aba atual\n",
    "    df = pd.read_excel(file_path, sheet_name=sheet_name, header=[0], index_col=0)\n",
    "    \n",
    "    # Extrair métricas e algoritmos\n",
    "    metrics = df.index.tolist()  # ['auc', 'positive', 'negative']\n",
    "    algorithms = [col.split('_')[0] for col in df.columns if '_mean' in col]  # ['KNN', 'LPMD', ...]\n",
    "    \n",
    "    # Configurações do gráfico\n",
    "    bar_width = 0.12\n",
    "    spacing = 0.02\n",
    "    x_pos = np.arange(len(metrics))\n",
    "    \n",
    "    # Criar figura\n",
    "    fig, ax = plt.subplots(figsize=(14, 6))\n",
    "    \n",
    "    # Plotar barras para cada algoritmo\n",
    "    for i, algo in enumerate(algorithms):\n",
    "        means = df[f'{algo}_mean'].values\n",
    "        stds = df[f'{algo}_std'].values\n",
    "        ax.bar(\n",
    "            x_pos + i * (bar_width + spacing),\n",
    "            means,\n",
    "            bar_width,\n",
    "            yerr=stds,\n",
    "            label=algo,\n",
    "            color=cores[i],\n",
    "            capsize=5,\n",
    "            edgecolor='black',\n",
    "            alpha=0.9\n",
    "        )\n",
    "    \n",
    "    # Ajustes do gráfico\n",
    "    ax.set_xticks(x_pos + (len(algorithms) / 2) * (bar_width + spacing) - bar_width / 2)\n",
    "    ax.set_xticklabels(['AUC', 'Recall (Positive)', 'Specificity (Negative)'])\n",
    "    ax.set_ylabel('Score')\n",
    "    ax.set_title(f'Desempenho dos Algoritmos de Imputação - {sheet_name} (Média ± DP)')\n",
    "    ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "    \n",
    "    # Remover bordas e ajustar layout\n",
    "    sns.despine(left=True, bottom=True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
