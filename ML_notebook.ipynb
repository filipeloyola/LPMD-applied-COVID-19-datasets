    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "\n",
    "# Configurar o estilo do Seaborn\n",
    "#sns.set_theme(style=\"pastel\") # Fundo com grid e estilo moderno\n",
    "#sns.set_theme(style=\"dark\")  # Fundo com grid e estilo moderno\n",
    "sns.set_theme(style=\"whitegrid\")  # Fundo com grid e estilo moderno\n",
    "\n",
    "# Carregar os dados\n",
    "file_path = 'geral_resultados_compilados.xlsx'\n",
    "df = pd.read_excel(file_path, sheet_name='Sheet1', header=[0, 1], index_col=0)\n",
    "df.columns = ['_'.join(col).strip() for col in df.columns.values]\n",
    "\n",
    "# Métricas e algoritmos\n",
    "metrics = ['auc', 'positive', 'negative']\n",
    "algorithms = ['KNN', 'LPMD', 'LPMD2', 'MICE', 'Mean', 'PMIVAE', 'SAEI']\n",
    "\n",
    "# --- PALETA DO SEABORN ---\n",
    "# Escolha uma das paletas disponíveis: 'deep', 'muted', 'bright', 'pastel', 'dark', 'colorblind'\n",
    "cores = sns.color_palette(\"deep\", n_colors=len(algorithms))\n",
    "\n",
    "# Configurações do gráfico\n",
    "bar_width = 0.12\n",
    "spacing = 0.02\n",
    "x_pos = np.arange(len(metrics))\n",
    "\n",
    "# Criar figura\n",
    "fig, ax = plt.subplots(figsize=(14, 7))\n",
    "\n",
    "# Plotar barras\n",
    "for i, algo in enumerate(algorithms):\n",
    "    means = [df.loc[metric, f'Mean_{algo}'] for metric in metrics]\n",
    "    stds = [df.loc[metric, f'Std_{algo}'] for metric in metrics]\n",
    "    ax.bar(\n",
    "        x_pos + i * (bar_width + spacing),\n",
    "        means,\n",
    "        bar_width,\n",
    "        yerr=stds,\n",
    "        label=algo,\n",
    "        color=cores[i],  # Usar a paleta do Seaborn\n",
    "        capsize=5,\n",
    "        edgecolor='black',\n",
    "        alpha=0.9\n",
    "    )\n",
    "\n",
    "# Ajustes finais\n",
    "ax.set_xticks(x_pos + (len(algorithms) / 2) * (bar_width + spacing) - bar_width / 2)\n",
    "ax.set_xticklabels(['AUC', 'Recall (Positive)', 'Specificity (Negative)'], fontsize=12)\n",
    "ax.set_ylabel('Score', fontsize=12)\n",
    "ax.set_title('Overall classification performance considering different imputation algorithms (Mean ± SD)', fontsize=14, pad=20)\n",
    "ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left', frameon=True)\n",
    "\n",
    "# Remover bordas do gráfico (estilo Seaborn)\n",
    "sns.despine(left=True, bottom=True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
