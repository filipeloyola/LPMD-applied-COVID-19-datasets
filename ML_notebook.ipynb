   "source": [
    "# gerar resultado compilado geral\n",
    "import pandas as pd\n",
    "\n",
    "# Caminho do arquivo\n",
    "file_path = 'geral_resultados.xlsx'\n",
    "\n",
    "# Carregar todas as abas do arquivo\n",
    "sheets = pd.read_excel(file_path, sheet_name=None)\n",
    "\n",
    "\n",
    "# Inicializar um dicionário para armazenar os resultados\n",
    "resultados = {}\n",
    "\n",
    "# Iterar sobre as abas\n",
    "for nome_aba, df in sheets.items():\n",
    "    for imputer in df.columns:\n",
    "        if imputer not in resultados:\n",
    "            resultados[imputer] = []\n",
    "        resultados[imputer].append(df[imputer].values)\n",
    "\n",
    "# Criar um novo DataFrame com a média e desvio padrão\n",
    "dados_finais = {}\n",
    "for imputer, valores in resultados.items():\n",
    "    valores_empilhados = pd.DataFrame(valores).T\n",
    "    dados_finais[f'{imputer}_mean'] = valores_empilhados.mean(axis=1)\n",
    "    dados_finais[f'{imputer}_std'] = valores_empilhados.std(axis=1)\n",
    "\n",
    "# Converter para DataFrame\n",
    "df_final = pd.DataFrame(dados_finais)\n",
    "\n",
    "# Salvar em um novo arquivo Excel\n",
    "output_file = 'resultado_compilado_final.xlsx'\n",
    "df_final.to_excel(output_file, index=False)\n",
    "\n",
    "print(f'Resultado salvo em: {output_file}')"
   ]
  },
