    "def classify_variable(series):\n",
    "    unique_values = series.nunique()\n",
    "    if series.dtype == 'float':\n",
    "        return 'Contínua'\n",
    "    elif series.dtype == 'int' and unique_values > 20:  # Limite arbitrário\n",
    "        return 'Possivelmente contínua'\n",
    "    else:\n",
    "        return 'Discreta'\n",
    "\n",
    "classification = {col: classify_variable(dataset1[col]) for col in dataset1.columns}\n",
    "\n",
    "for i, j in classification.items():\n",
    "    print(i, j)"
   ]
